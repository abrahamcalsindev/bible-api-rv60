{
  "name": "bible-api-rv60",
  "version": "1.0.0",
  "description": "",
  "main": "src/app.ts",
  "scripts": {
    "start": "node dist/src/app.js",
    "dev": "nodemon ./src/app.ts",
    "build": "npm run clean && tsc && tsc-alias",
    "clean": "rimraf -rf dist",
    "lint": "eslint \"src/**/*.ts\" \"database/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"database/**/*.ts\" --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "abrahamcalsindev",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^18.14.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "nodemon": "^2.0.20",
    "rimraf": "^4.4.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.2",
    "tsconfig-paths": "^3.14.2",
    "typescript": "^4.9.5"
  },
  "nodemonConfig": {
    "env": {
      "TZ": "utc"
    },
    "exec": "ts-node --transpile-only -r tsconfig-paths/register",
    "ext": "ts,js"
  }
}
